local function applySpoof()
    if not currentExistLabel or not currentExistLabel.Parent then
        currentExistLabel = findExistLabel()
    end
    if currentExistLabel and spoofAmount then
        currentExistLabel.Text = formatNumber(spoofAmount) .. " Exist"
    end
end

local function startMonitor()
    if monitorConn then monitorConn:Disconnect() end
    monitorConn = RunService.Heartbeat:Connect(function()
        if not spoofAmount then return end
        if not currentExistLabel or not currentExistLabel.Parent then
            currentExistLabel = findExistLabel()
        end
        if currentExistLabel then
            local target = formatNumber(spoofAmount) .. " Exist"
            if currentExistLabel.Text ~= target then
                currentExistLabel.Text = target
            end
        end
    end)
end

ApplyBtn.MouseButton1Click:Connect(function()
    local input = TextBox.Text:gsub(",", ""):gsub("%s", "")
    local num = tonumber(input)
    if not num then
        Status.Text = "Invalid!"
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    spoofAmount = math.floor(num)
    currentExistLabel = findExistLabel()
    if not currentExistLabel then
        Status.Text = "Open glossary first"
        Status.TextColor3 = Color3.fromRGB(255, 180, 80)
        return
    end
    if not originalText then originalText = currentExistLabel.Text end
    applySpoof()
    startMonitor()
    Status.Text = formatNumber(spoofAmount)
    Status.TextColor3 = Color3.fromRGB(0, 150, 255)
end)

